---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={`${title} | ${SITE.NAME}`} description={description} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- botika webchat begin -->
    <script is:inline>
      (function() {
        // Load botika script into <head> so it persists across view transitions
        if (!document.getElementById("botika-widget-script")) {
          var script = document.createElement("script");
          script.id = "botika-widget-script";
          script.src = "https://chat.botika.online/v3/widget/script.js";
          script.onload = function() {
            if (typeof botika !== "undefined" && botika.init) {
              botika.init({ appId: "ksUzCm3" });
            }
          };
          document.head.appendChild(script);
        }

        // Preserve the Botika widget DOM across Astro view transitions since DOMContentLoaded only fires once.
        if (!window.__botikaSwapListenerAdded) {
          window.__botikaSwapListenerAdded = true;
          document.addEventListener("astro:before-swap", function(e) {
            // Move the widget container (#botika-widget) to the new body
            var widget = document.getElementById("botika-widget");
            if (widget) {
              e.newDocument.body.appendChild(widget);
            }
            // Move the widget stylesheet to the new head
            var styles = document.querySelectorAll('link[href*="chat.botika.online"]');
            styles.forEach(function(link) {
              e.newDocument.head.appendChild(link);
            });
          });
        }
      })();
    </script>
    <!-- botika webchat end -->
  </body>
</html>
